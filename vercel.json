{
  "trailingSlash": false,
  "cleanUrls": false,
  "redirects": [
    { "source": "/consult", "destination": "/local-business", "permanent": true },
    { "source": "/consult.html", "destination": "/local-business", "permanent": true },
    { "source": "/enterprise", "destination": "/b2b-marketing", "permanent": true },
    { "source": "/local-business.html", "destination": "/local-business", "permanent": true },
    { "source": "/self-employed.html", "destination": "/self-employed", "permanent": true },
    { "source": "/b2b-marketing.html", "destination": "/b2b-marketing", "permanent": true },
    { "source": "/public-sector.html", "destination": "/public-sector", "permanent": true },
    { "source": "/brochure.html", "destination": "/brochure", "permanent": true }
  ],
  "rewrites": [
    { "source": "/local-business", "destination": "/local-business.html" },
    { "source": "/self-employed", "destination": "/self-employed.html" },
    { "source": "/b2b-marketing", "destination": "/b2b-marketing.html" },
    { "source": "/public-sector", "destination": "/public-sector.html" },
    { "source": "/brochure", "destination": "/brochure.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
